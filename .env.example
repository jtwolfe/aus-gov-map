# --- Web (apps/web) ---
# Leave unset to serve the bundled fixture seed (offline / no Docker).
DATABASE_URL=postgresql://ausgov:ausgov@localhost:5432/ausgov

# Optional: Neo4j is used by ingest for the involvement graph.
# The web app Stage 1 reads people↔hearings from Postgres/fixtures.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=ausgovmap

# --- Ingest (services/ingest) ---
# Same DATABASE_URL / Neo4j vars as above.
EMBEDDING_PROVIDER=hash
# EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_PROVIDER=sentence-transformers
# ST_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Hash / default vector size. Must match Postgres vector(N) in infra/postgres.
EMBEDDING_DIM=384

# Optional override for the fixture seed JSON.
# AUS_GOV_FIXTURE_PATH=/absolute/path/to/data/fixtures/seed.json
# Optional override for saved APH /api/hansard/transcript JSON (file or directory).
# AUS_GOV_TRANSCRIPT_PATH=/absolute/path/to/services/ingest/fixtures/live/transcripts

# HTTP fetch. APH Azure WAF 403s bot-like User-Agents; a browser-like UA
# is required for www.aph.gov.au. parlinfo.aph.gov.au still JS-challenges
# many datacentre IPs — ingest uses /api/hansard/* on www.aph.gov.au instead.
INGEST_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/128.0.0.0 Safari/537.36
INGEST_TIMEOUT_SECONDS=45
INGEST_RATE_LIMIT_SECONDS=0.6
INGEST_MAX_RETRIES=3
INGEST_INCLUDE_TRANSCRIPTS=1

# When live APH/ParlInfo fetch fails or returns nothing, load fixtures.
INGEST_FALLBACK_FIXTURE=1
